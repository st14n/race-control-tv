<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".RaceControlTvApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/launcher"
        android:banner="@drawable/banner"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".ui.MainActivity"
            android:label="@string/app_name"
            android:screenOrientation="landscape"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.channel.playback.ChannelPlaybackActivity"
            android:theme="@style/PlaybackTheme"
            android:launchMode="singleTop"
            android:screenOrientation="userLandscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|colorMode|density"
            android:hardwareAccelerated="true" />
        <activity android:name=".ui.season.browse.SeasonBrowseActivity" />
        <activity android:name=".ui.session.browse.SessionBrowseActivity" />
        <activity android:name=".ui.signin.SignInActivity" />
        <activity android:name=".ui.season.archive.SeasonArchiveActivity"/>
        <activity android:name=".ui.home.HomeActivity"/>
        <activity android:name=".ui.settings.SettingsActivity"/>

    </application>

</manifest>
