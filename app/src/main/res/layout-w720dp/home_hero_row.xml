<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="236dp"
    android:orientation="horizontal"
    android:paddingStart="40dp"
    android:paddingEnd="40dp"
    android:paddingTop="10dp"
    android:paddingBottom="8dp">

    <!-- The newest weekend's session: big, with its picture -->
    <FrameLayout
        android:id="@+id/hero_card"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/hero_background"
        android:clickable="true"
        android:focusable="true"
        android:foreground="@drawable/hero_focus_outline">

        <ImageView
            android:id="@+id/hero_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/hero_side_scrim" />

        <View
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_gravity="bottom"
            android:background="@drawable/hero_scrim" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hero_badge_live"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/badge_live"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.06"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/home_badge_live"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/hero_badge_kind"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:background="@drawable/badge_dark"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="@color/rc_text"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp"
            android:layout_marginBottom="18dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hero_kicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/rc_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/hero_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-condensed"
                android:maxLines="1"
                android:textColor="@color/rc_text"
                android:textSize="38sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/hero_play"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/play_pill"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:textColor="@color/rc_background"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/hero_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="@string/home_hero_hint"
                    android:textColor="@color/rc_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Continue watching: replays stopped halfway -->
    <LinearLayout
        android:id="@+id/continue_column"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_marginStart="24dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:text="@string/home_continue_watching"
            android:textAllCaps="true"
            android:textColor="@color/rc_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/continue_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/continue_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/continue_item_background"
            android:padding="14dp"
            android:text="@string/home_continue_empty"
            android:textColor="@color/rc_text_muted"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
