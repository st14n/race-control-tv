<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:text="@string/channel_selection_switch_channel"
            android:textColor="@color/rc_text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:text="@string/feed_picker_main"
            android:textAllCaps="true"
            android:textColor="@color/rc_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/feed_picker_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/feed_picker_onboard_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:text="@string/feed_picker_onboard"
            android:textAllCaps="true"
            android:textColor="@color/rc_text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <GridLayout
            android:id="@+id/feed_picker_onboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:columnCount="3" />

        <TextView
            android:id="@+id/feed_picker_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/feed_picker_loading"
            android:textColor="@color/rc_text_muted"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/feed_picker_hint"
            android:textColor="@color/rc_text_muted"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
