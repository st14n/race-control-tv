<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">

    <!-- Mask layout to hide launcher during buffering/loading.
         DIAGNOSTIC (2026-09-11): kept GONE. While visible this opaque full-screen
         View suppresses the window's transparent region entirely
         (transparentRegionHint came back empty), so SurfaceFlinger never learns the
         SurfaceView punches a hole and the HWC cannot keep the protected HDR buffer
         on its dedicated video plane. The official app reports 21 transparent
         rects here and renders correctly. -->
    <View
        android:id="@+id/playback_black_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="@android:color/black" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:name="fr.groggy.racecontrol.tv.ui.LoadingFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"/>

    <TextView
        android:id="@+id/closed_captions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:visibility="gone"
        android:layout_margin="62dp"
        android:textSize="24sp"
        android:textColor="@android:color/white"
        android:background="#80000000"
        tools:visibility="visible"
        tools:text="I am a closed caption"/>

</RelativeLayout>
