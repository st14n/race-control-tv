<?xml version="1.0" encoding="utf-8"?>
<!-- Archive of the redesign: a title, then one row of seasons per decade -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rc_background"
    android:orientation="vertical">

    <TextView
        android:id="@+id/archive_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/rc_screen_gutter"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="4dp"
        android:fontFamily="sans-serif-condensed"
        android:textColor="@color/rc_text"
        android:textSize="32sp"
        android:textStyle="bold" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:name="fr.groggy.racecontrol.tv.ui.season.archive.SeasonArchiveFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</LinearLayout>
