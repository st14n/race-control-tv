# Copy this file to .env and fill in your values.
# .env is listed in .gitignore and will NOT be committed to version control.

# F1TV credentials (used as fallback when no credentials are saved on the device)
# Leave empty to require manual login on first run.
F1_username =
F1_password =

# Token re-authentication interval in milliseconds.
# Default when absent: 21600000 (6 hours).
# Use 300000 (5 minutes) for development/testing.
# TOKEN_REFRESH_INTERVAL_MS = 21600000

# GP Radio stream URL overrides.
# Defaults to streamtheworld URLs when absent.
# GP_RADIO_URL_MP3 = https://playerservices.streamtheworld.com/api/livestream-redirect/GRAND_PRIX_RADIO.mp3
# GP_RADIO_URL_SC  = https://playerservices.streamtheworld.com/api/livestream-redirect/GRAND_PRIX_RADIO_SC
# GP_RADIO_URL_AAC = https://playerservices.streamtheworld.com/api/livestream-redirect/GRAND_PRIX_RADIOAAC.aac
